{
  "name": "meu-caixa",
  "productName": "Meu Caixa",
  "version": "1.0.0",
  "description": "Painel de finanças pessoais que sincroniza bancos e cartões pelo Open Finance (Meu Pluggy).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/rules.test.js",
    "pack:win": "electron-packager . \"Meu Caixa\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=^/dist --ignore=^/test --ignore=^/tools --ignore=^/README.md --ignore=^/web --ignore=^/api --ignore=^/vercel.json --app-copyright=\"Uso pessoal\"",
    "build:web": "node web/build.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "33.4.11"
  }
}
